<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Summary</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .animate-slide-in {
            animation: slideInUp 0.6s ease-out;
        }

        .animate-fade-in {
            animation: fadeIn 0.8s ease-out;
        }

        .card-section {
            transition: all 0.3s ease;
        }

        .card-section:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
        }

        .info-item {
            position: relative;
            overflow: hidden;
        }

        .info-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 3px;
            background: linear-gradient(to bottom, #14b8a6, #f97316);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .info-item:hover::before {
            opacity: 1;
        }

        .payment-badge {
            background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
        }

        .consultant-card {
            background: linear-gradient(135deg, #ffffff 0%, #f0fdfa 100%);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-teal-50 min-h-screen font-sans">
    <div class="relative w-full min-h-screen py-8 px-4">
        <!-- Main Content -->
        <main class="max-w-5xl mx-auto animate-slide-in">
            
            <!-- Header Section -->
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-1 h-8 bg-gradient-to-b from-teal-500 to-orange-500 rounded-full"></div>
                    <h2 class="text-4xl font-bold text-gray-900 max-md:text-3xl">Booking Summary</h2>
                </div>
                <p class="text-gray-600 ml-7">Review your consultation details before confirming</p>
            </div>

            <!-- Consultant Card -->
            <section class="consultant-card rounded-2xl shadow-lg p-6 mb-6 card-section border border-teal-100">
                <div class="flex items-center gap-2 mb-4">
                    <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <h3 class="text-xl font-bold text-gray-900">Your Consultant</h3>
                </div>
                
                <div class="flex gap-5 items-center max-md:flex-col max-md:items-start">
                    <!-- Avatar with gradient border -->
                    <div class="relative">
                        <div class="absolute inset-0 bg-gradient-to-br from-teal-400 to-orange-400 rounded-full blur-md opacity-50"></div>
                        <div class="relative w-20 h-20 rounded-full border-4 border-white shadow-lg overflow-hidden">
                            <img
                                src="https://api.builder.io/api/v1/image/assets/TEMP/011ba4f9948d0fc7d695602d721038f57224509a?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                alt="Budi Santosa"
                                class="w-full h-full object-cover"
                            />
                        </div>
                    </div>

                    <!-- Consultant Info -->
                    <div class="flex-1">
                        <h4 class="text-xl font-bold text-gray-900 mb-1">Budi Santosa, M.Si</h4>
                        <p class="text-gray-600 flex items-center gap-2">
                            <svg class="w-4 h-4 text-teal-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd" />
                                <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z" />
                            </svg>
                            Sustainability Analyst | UKM & Agrikultur
                        </p>
                        <div class="flex gap-2 mt-3">
                            <span class="px-3 py-1 bg-teal-100 text-teal-700 text-xs font-semibold rounded-full">Expert</span>
                            <span class="px-3 py-1 bg-orange-100 text-orange-700 text-xs font-semibold rounded-full">Verified</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Booking Details Card -->
            <section class="bg-white rounded-2xl shadow-lg p-6 mb-6 card-section">
                <div class="flex items-center gap-2 mb-6">
                    <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <h3 class="text-xl font-bold text-gray-900">Booking Details</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Date -->
                    <div class="info-item p-4 rounded-xl bg-gray-50 hover:bg-teal-50 transition-colors">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Date</p>
                                <p class="text-base font-bold text-gray-900">July 20, 2024</p>
                            </div>
                        </div>
                    </div>

                    <!-- Time -->
                    <div class="info-item p-4 rounded-xl bg-gray-50 hover:bg-teal-50 transition-colors">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Time</p>
                                <p class="text-base font-bold text-gray-900">09:00 AM</p>
                            </div>
                        </div>
                    </div>

                    <!-- Duration -->
                    <div class="info-item p-4 rounded-xl bg-gray-50 hover:bg-teal-50 transition-colors">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Duration</p>
                                <p class="text-base font-bold text-gray-900">1 hour</p>
                            </div>
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="info-item p-4 rounded-xl bg-gradient-to-br from-orange-50 to-orange-100 hover:from-orange-100 hover:to-orange-200 transition-colors border-2 border-orange-200">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600 font-medium">Total Price</p>
                                <p class="text-xl font-bold text-orange-600">Rp 350.000</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Payment Method Card -->
            <section class="bg-white rounded-2xl shadow-lg p-6 mb-8 card-section">
                <div class="flex items-center gap-2 mb-4">
                    <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <h3 class="text-xl font-bold text-gray-900">Payment Method</h3>
                </div>

                <div class="flex items-center gap-4 p-4 bg-gradient-to-r from-teal-50 to-green-50 rounded-xl border-2 border-teal-200">
                    <!-- QR Icon -->
                    <div class="w-14 h-14 payment-badge rounded-xl flex items-center justify-center shadow-lg">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                        </svg>
                    </div>

                    <!-- Payment Info -->
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1">
                            <h4 class="text-lg font-bold text-gray-900">QRIS</h4>
                            <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs font-semibold rounded-full">Secure</span>
                        </div>
                        <p class="text-sm text-gray-600">Quick Response Indonesian Standard</p>
                    </div>

                    <!-- Checkmark -->
                    <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                </div>
            </section>

            <!-- Confirmation Button -->
            <div class="flex justify-end gap-4 animate-fade-in">
                <a href="/mitra/konsultan" 
                   class="px-8 py-3.5 bg-white border-2 border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-md hover:shadow-lg">
                    Cancel
                </a>
                <a href="/mitra/bookingTransaksi" 
                   class="relative px-12 py-3.5 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300 overflow-hidden group">
                    <span class="relative z-10 flex items-center gap-2">
                        Confirm Booking
                        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </span>
                    <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity"></div>
                </a>
            </div>

            <!-- Info Banner -->
            <div class="mt-8 p-4 bg-blue-50 border border-blue-200 rounded-xl flex items-start gap-3">
                <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="text-sm text-blue-800">
                    <p class="font-semibold mb-1">Important Notice</p>
                    <p>Please ensure you're available at the scheduled time. A reminder will be sent 24 hours before your consultation.</p>
                </div>
            </div>
        </main>
    </div>
</body>
</html>