<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - Consultation</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Main Content -->
    <main class="flex flex-col mt-20 mx-auto w-full max-w-7xl px-4 max-md:mt-10">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-4xl font-semibold text-neutral-900">My Consultations</h2>
                <p class="text-gray-600 mt-2">Manage your consultation bookings</p>
            </div>
            <div class="flex gap-2">
                <span class="px-4 py-2 bg-orange-100 text-orange-600 rounded-full text-sm font-medium">
                    <span class="inline-block w-2 h-2 bg-orange-600 rounded-full mr-2"></span>
                    <span id="pendingCount">1</span> Pending
                </span>
                <span class="px-4 py-2 bg-green-100 text-green-600 rounded-full text-sm font-medium">
                    <span class="inline-block w-2 h-2 bg-green-600 rounded-full mr-2"></span>
                    <span id="activeCount">1</span> Active
                </span>
            </div>
        </div>

        <div class="flex gap-5 max-md:flex-col">
            <!-- Sidebar Navigation -->
            <aside class="w-64 max-md:w-full">
                <nav class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 sticky top-4">
                    <a href="/mitra/cari-konsultan" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        <span class="font-medium">Search</span>
                    </a>
                    <a href="/mitra/bookingTransaksi" class="nav-link flex items-center gap-3 px-4 py-3 mt-2 rounded-lg bg-orange-500 text-white shadow-lg transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <span class="font-medium">Bookings</span>
                    </a>
                    <a href="/mitra/pembayaran" class="nav-link flex items-center gap-3 px-4 py-3 mt-2 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                        </svg>
                        <span class="font-medium">Payment</span>
                    </a>
                    <a href="/mitra/history" class="nav-link flex items-center gap-3 px-4 py-3 mt-2 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span class="font-medium">History</span>
                    </a>
                </nav>
            </aside>

            <!-- Consultation Cards Section -->
            <section class="flex-1">
                <div class="space-y-6">
                    <!-- Filter Tabs -->
                    <div class="bg-white rounded-xl border border-gray-200 p-2 flex gap-2">
                        <button onclick="filterBookings('all')" class="filter-btn flex-1 px-4 py-2 rounded-lg font-medium text-white bg-teal-600 transition-colors">
                            All Bookings
                        </button>
                        <button onclick="filterBookings('pending')" class="filter-btn flex-1 px-4 py-2 rounded-lg font-medium text-gray-600 hover:bg-gray-100 transition-colors">
                            Pending
                        </button>
                        <button onclick="filterBookings('active')" class="filter-btn flex-1 px-4 py-2 rounded-lg font-medium text-gray-600 hover:bg-gray-100 transition-colors">
                            Active
                        </button>
                        <button onclick="filterBookings('completed')" class="filter-btn flex-1 px-4 py-2 rounded-lg font-medium text-gray-600 hover:bg-gray-100 transition-colors">
                            Completed
                        </button>
                    </div>

                    <!-- Pending Consultation Card -->
                    <article class="booking-card pending bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100">
                        <div class="p-6">
                            <div class="flex flex-wrap gap-5 justify-between items-start">
                                <div class="flex gap-4 flex-1">
                                    <img
                                        src="https://api.builder.io/api/v1/image/assets/TEMP/011ba4f9948d0fc7d695602d721038f57224509a?placeholderIfAbsent=true&apiKey=39663306a6124fc48ebdaf49ce52c1d3"
                                        alt="Budi Santosa Profile"
                                        class="w-20 h-20 rounded-full object-cover border-2 border-gray-200"
                                    />
                                    <div class="flex-1">
                                        <h3 class="text-xl font-semibold text-teal-700">
                                            Budi Santosa, M.Si
                                        </h3>
                                        <p class="mt-1 text-sm text-gray-500">
                                            Sustainability Analyst | SME & Agriculture
                                        </p>
                                        <div class="mt-3 flex items-center gap-2 text-sm">
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                            <time class="font-medium text-gray-700">
                                                Wednesday, August 20, 2025
                                            </time>
                                        </div>
                                        <div class="mt-2 flex items-center gap-2 text-sm">
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            <span class="font-medium text-gray-700">09:00 AM - 11:00 AM</span>
                                            <span class="ml-2 text-gray-500">(2 hours)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex flex-col items-end gap-3">
                                    <span class="px-4 py-2 text-xs font-semibold text-orange-600 bg-orange-50 rounded-full border-2 border-orange-100">
                                        Pending Payment
                                    </span>
                                    <span class="text-lg font-bold text-teal-700">$45.00</span>
                                </div>
                            </div>
                            
                            <div class="mt-6 flex gap-3">
                                <button onclick="cancelBooking(this)" class="flex-1 px-4 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                                    Cancel Booking
                                </button>
                                <button onclick="proceedToPayment()" class="flex-1 px-4 py-2.5 text-sm font-medium text-white bg-lime-500 rounded-lg hover:bg-lime-600 transition-colors shadow-md">
                                    Pay Now
                                </button>
                            </div>
                        </div>
                    </article>

                    <!-- Active Consultation Card -->
                    <article class="booking-card active bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100">
                        <div class="p-6">
                            <div class="flex flex-wrap gap-5 justify-between items-start">
                                <div class="flex gap-4 flex-1">
                                    <img
                                        src="https://api.builder.io/api/v1/image/assets/TEMP/011ba4f9948d0fc7d695602d721038f57224509a?placeholderIfAbsent=true&apiKey=39663306a6124fc48ebdaf49ce52c1d3"
                                        alt="Budi Santosa Profile"
                                        class="w-20 h-20 rounded-full object-cover border-2 border-green-200"
                                    />
                                    <div class="flex-1">
                                        <h3 class="text-xl font-semibold text-teal-700">
                                            Budi Santosa, M.Si
                                        </h3>
                                        <p class="mt-1 text-sm text-gray-500">
                                            Sustainability Analyst | SME & Agriculture
                                        </p>
                                        <div class="mt-3 flex items-center gap-2 text-sm">
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                            <time class="font-medium text-gray-700">
                                                Tuesday, August 19, 2025
                                            </time>
                                        </div>
                                        <div class="mt-2 flex items-center gap-2 text-sm">
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            <span class="font-medium text-gray-700">09:00 AM - 11:00 AM</span>
                                            <span class="ml-2 text-gray-500">(2 hours)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex flex-col items-end gap-3">
                                    <span class="px-4 py-2 text-xs font-semibold text-green-600 bg-green-50 rounded-full border-2 border-green-100">
                                        Confirmed
                                    </span>
                                    <span class="text-lg font-bold text-teal-700">$45.00</span>
                                </div>
                            </div>
                            
                            <div class="mt-6 flex gap-3">
                                <button onclick="viewDetails()" class="flex-1 px-4 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                                    View Details
                                </button>
                                <button onclick="startChat()" class="flex-1 px-4 py-2.5 text-sm font-medium text-white bg-teal-600 rounded-lg hover:bg-teal-700 transition-colors shadow-md flex items-center justify-center gap-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                    </svg>
                                    Start Chat
                                </button>
                            </div>
                        </div>
                    </article>

                    <!-- Empty State (hidden by default) -->
                    <div id="emptyState" class="hidden bg-white rounded-2xl shadow-lg p-12 text-center">
                        <svg class="w-24 h-24 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <h3 class="mt-6 text-xl font-semibold text-gray-900">No bookings found</h3>
                        <p class="mt-2 text-gray-500">You don't have any bookings in this category yet.</p>
                        <button onclick="filterBookings('all')" class="mt-6 px-6 py-3 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors">
                            View All Bookings
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        // Filter functionality to manage booking views
        function filterBookings(status) {
            const cards = document.querySelectorAll('.booking-card');
            const emptyState = document.getElementById('emptyState');
            const filterBtns = document.querySelectorAll('.filter-btn');

            // Update active filter button
            filterBtns.forEach(btn => {
                btn.classList.remove('bg-teal-600', 'text-white');
                btn.classList.add('text-gray-600', 'hover:bg-gray-100');
            });

            event.target.classList.remove('text-gray-600', 'hover:bg-gray-100');
            event.target.classList.add('bg-teal-600', 'text-white');

            let visibleCount = 0;

            // Show or hide booking cards based on the selected status
            cards.forEach(card => {
                if (status === 'all' || card.classList.contains(status)) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Show empty state if no bookings match the filter
            if (visibleCount === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }
        }

        // Booking actions
        function cancelBooking(button) {
            if (confirm('Are you sure you want to cancel this booking?')) {
                const card = button.closest('.booking-card');
                card.style.opacity = '0';
                card.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    card.remove();
                    updateCounts();
                    alert('Booking cancelled successfully');
                }, 300);
            }
        }

        function proceedToPayment() {
            alert('Redirecting to payment page...');
            // In real app: window.location.href = '/payment';
        }

        function viewDetails() {
            alert('Opening booking details...');
            // In real app: show modal or redirect
        }

        function startChat() {
            window.location.href = '/mitra/chatKonsultan';
            // In real app: window.location.href = '/chat/consultant';
        }

        // Update booking counts based on active and pending bookings
        function updateCounts() {
            const pendingCount = document.querySelectorAll('.booking-card.pending').length;
            const activeCount = document.querySelectorAll('.booking-card.active').length;

            document.getElementById('pendingCount').textContent = pendingCount;
            document.getElementById('activeCount').textContent = activeCount;
        }

        // Add hover effects to cards
        document.querySelectorAll('.booking-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-4px)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Initialize page (counts and other actions)
        window.onload = function() {
            updateCounts();
        };
    </script>
</body>
</html>