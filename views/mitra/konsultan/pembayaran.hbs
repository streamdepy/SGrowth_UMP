                        </svg>
                        <span class="font-medium">History</span>
                    </a>
                </nav>
            </aside>

            <!-- Payment Cards Grid -->
            <section class="ml-5 w-[82%] max-md:ml-0 max-md:w-full">
                <div class="w-full max-md:mt-7 max-md:max-w-full">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                        <!-- Payment Card 1 - Pending Payment -->
                        <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow">
                            <div class="p-7">
                                <div class="flex gap-5 max-md:flex-col">
                                    <div class="flex-shrink-0">
                                        <img
                                            src="https://api.builder.io/api/v1/image/assets/TEMP/011ba4f9948d0fc7d695602d721038f57224509a?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                            alt="Budi Santosa Profile"
                                            class="object-cover rounded-full w-20 h-20"
                                        />
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="text-xl font-semibold text-teal-700">Budi Santosa, M.Si</h3>
                                        <p class="mt-2 text-sm text-gray-500">Sustainability Analyst | SME & Agriculture</p>
                                        
                                        <div class="mt-4 flex items-center gap-2">
                                            <span class="text-sm font-medium text-gray-600">Status:</span>
                                            <span class="px-3 py-1 text-xs font-semibold text-orange-600 bg-orange-100 rounded-full">Pending Payment</span>
                                        </div>
                                        
                                        <div class="mt-3 text-sm text-gray-600">
                                            <span class="font-medium">Session Date:</span> 
                                            <span class="text-gray-900">July 15, 2025 at 10:00 AM</span>
                                        </div>
                                        
                                        <div class="mt-3 flex items-baseline gap-2">
                                            <span class="text-sm font-medium text-gray-600">Rate:</span>
                                            <span class="text-lg font-bold text-neutral-900">$45/hour</span>
                                        0/hour</span>
                                        </div>
                                        
                                        <button onclick="openPaymentModal(1)" class="mt-5 w-full flex justify-center items-center px-6 py-3 font-semibold text-white bg-lime-500 rounded-xl hover:bg-lime-600 transition-colors shadow-md">
                                            Pay Now
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </article>

                        <!-- Payment Card 2 - Paid -->
                        <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow">
                            <div class="p-7">
                                <div class="flex gap-5 max-md:flex-col">
                                    <div class="flex-shrink-0">
                                        <img
                                            src="https://api.builder.io/api/v1/image/assets/TEMP/011ba4f9948d0fc7d695602d721038f57224509a?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                            alt="Budi Santosa Profile"
                                            class="object-cover rounded-full w-20 h-20"
                                        />
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="text-xl font-semibold text-teal-700">Budi Santosa, M.Si</h3>
                                        <p class="mt-2 text-sm text-gray-500">Sustainability Analyst | SME & Agriculture</p>
                                        
                                        <div class="mt-4 flex items-center gap-2">
                                            <span class="text-sm font-medium text-gray-600">Status:</span>
                                            <span class="px-3 py-1 text-xs font-semibold text-green-600 bg-green-100 rounded-full">Paid</span>
                                        </div>
                                        
                                        <div class="mt-3 text-sm text-gray-600">
                                            <span class="font-medium">Session Date:</span> 
                                            <span class="text-gray-900">July 20, 2025 at 2:00 PM</span>
                                        </div>
                                        
                                        <div class="mt-3 flex items-baseline gap-2">
                                            <span class="text-sm font-medium text-gray-600">Rate:</span>
                                            <span class="text-lg font-bold text-neutral-900">$45/hour</span>
                                        </div>
                                        
                                        <button disabled class="mt-5 w-full flex justify-center items-center px-6 py-3 font-semibold text-white bg-gray-400 rounded-xl cursor-not-allowed shadow-md">
                                            Paid
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </article>

                        <!-- Payment Card 3 - Pending -->
                        <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow">
                            <div class="p-7">
                                <div class="flex gap-5 max-md:flex-col">
                                    <div class="flex-shrink-0">
                                        <img
                                            src="https://shopee.co.id/inspirasi-shopee/wp-content/uploads/2023/11/biodata-sarah-gibson-1.jpg"
                                            alt="Consultant Profile"
                                            class="object-cover rounded-full w-20 h-20"
                                        />
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="text-xl font-semibold text-teal-700">Sarah Johnson, Ph.D</h3>
                                        <p class="mt-2 text-sm text-gray-500">Business Strategy Consultant</p>
                                        
                                        <div class="mt-4 flex items-center gap-2">
                                            <span class="text-sm font-medium text-gray-600">Status:</span>
                                            <span class="px-3 py-1 text-xs font-semibold text-orange-600 bg-orange-100 rounded-full">Pending Payment</span>
                                        </div>
                                        
                                        <div class="mt-3 text-sm text-gray-600">
                                            <span class="font-medium">Session Date:</span> 
                                            <span class="text-gray-900">July 18, 2025 at 3:00 PM</span>
                                        </div>
                                        
                                        <div class="mt-3 flex items-baseline gap-2">
                                            <span class="text-sm font-medium text-gray-600">Rate:</span>
                                            <span class="text-lg font-bold text-neutral-900">$35/hour</span>
                                        </div>
                                        
                                        <button onclick="openPaymentModal(2)" class="mt-5 w-full flex justify-center items-center px-6 py-3 font-semibold text-white bg-lime-500 rounded-xl hover:bg-lime-600 transition-colors shadow-md">
                                            Pay Now
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- Payment Modal -->
    <div id="paymentModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
                <h3 class="text-2xl font-bold text-neutral-900">Select Payment Method</h3>
                <button onclick="closePaymentModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            
            <div class="p-6">
                <!-- Payment Summary -->
                <div class="bg-teal-50 rounded-xl p-5 mb-6">
                    <h4 class="font-semibold text-teal-900 mb-3">Payment Summary</h4>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Consultant:</span>
                            <span class="font-medium text-gray-900" id="modalConsultant">Budi Santosa, M.Si</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Session Date:</span>
                            <span class="font-medium text-gray-900" id="modalDate">July 15, 2025 at 10:00 AM</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Duration:</span>
                            <span class="font-medium text-gray-900">1 hour</span>
                        </div>
                        <div class="border-t border-teal-200 mt-3 pt-3 flex justify-between">
                            <span class="font-semibold text-gray-900">Total Amount:</span>
                            <span class="text-xl font-bold text-teal-700" id="modalAmount">$45</span>
                        </div>
                    </div>
                </div>

                <!-- Payment Methods -->
                <h4 class="font-semibold text-neutral-900 mb-4">Choose Payment Method</h4>
                <div class="space-y-3">
                    <!-- Credit/Debit Card -->
                    <label class="payment-method flex items-center gap-4 p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-teal-500 hover:bg-teal-50 transition-all">
                        <input type="radio" name="paymentMethod" value="card" class="w-5 h-5 text-teal-600">
                        <div class="flex items-center gap-3 flex-1">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                            </svg>
                            <div>
                                <div class="font-semibold text-gray-900">Credit / Debit Card</div>
                                <div class="text-sm text-gray-500">Visa, Mastercard, Amex</div>
                            </div>
                        </div>
                    </label>

                    <!-- Bank Transfer -->
                    <label class="payment-method flex items-center gap-4 p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-teal-500 hover:bg-teal-50 transition-all">
                        <input type="radio" name="paymentMethod" value="bank" class="w-5 h-5 text-teal-600">
                        <div class="flex items-center gap-3 flex-1">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>
                            </svg>
                            <div>
                                <div class="font-semibold text-gray-900">Bank Transfer</div>
                                <div class="text-sm text-gray-500">Direct bank transfer</div>
                            </div>
                        </div>
                    </label>

                    <!-- E-Wallet -->
                    <label class="payment-method flex items-center gap-4 p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-teal-500 hover:bg-teal-50 transition-all">
                        <input type="radio" name="paymentMethod" value="ewallet" class="w-5 h-5 text-teal-600">
                        <div class="flex items-center gap-3 flex-1">
                            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <div>
                                <div class="font-semibold text-gray-900">E-Wallet</div>
                                <div class="text-sm text-gray-500">PayPal, Apple Pay, Google Pay</div>
                            </div>
                        </div>
                    </label>

                    <!-- Cryptocurrency -->
                    <label class="payment-method flex items-center gap-4 p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-teal-500 hover:bg-teal-50 transition-all">
                        <input type="radio" name="paymentMethod" value="crypto" class="w-5 h-5 text-teal-600">
                        <div class="flex items-center gap-3 flex-1">
                            <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                            <div>
                                <div class="font-semibold text-gray-900">Cryptocurrency</div>
                                <div class="text-sm text-gray-500">Bitcoin, Ethereum, USDT</div>
                            </div>
                        </div>
                    </label>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-3 mt-6">
                    <button onclick="closePaymentModal()" class="flex-1 px-6 py-3 font-semibold text-gray-700 bg-gray-200 rounded-xl hover:bg-gray-300 transition-colors">
                        Cancel
                    </button>
                    <button onclick="processPayment()" class="flex-1 px-6 py-3 font-semibold text-white bg-lime-500 rounded-xl hover:bg-lime-600 transition-colors shadow-md">
                        Confirm Payment
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const paymentData = {
            1: {
                consultant: "Budi Santosa, M.Si",
                date: "July 15, 2025 at 10:00 AM",
                amount: "$50"
            },
            2: {
                consultant: "Sarah Johnson, M.Si",
                date: "July 18, 2025 at 3:00 PM",
                amount: "$75"
            }
        };

        function openPaymentModal(cardId) {
            const modal = document.getElementById('paymentModal');
            const data = paymentData[cardId];
            
            document.getElementById('modalConsultant').textContent = data.consultant;
            document.getElementById('modalDate').textContent = data.date;
            document.getElementById('modalAmount').textContent = data.amount;
            
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closePaymentModal() {
            const modal = document.getElementById('paymentModal');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
            
            // Reset radio buttons
            document.querySelectorAll('input[name="paymentMethod"]').forEach(radio => {
                radio.checked = false;
            });
        }

        function processPayment() {
            const selectedMethod = document.querySelector('input[name="paymentMethod"]:checked');
            
            if (!selectedMethod) {
                alert('Please select a payment method');
                return;
            }

            const methodNames = {
                'card': 'Credit/Debit Card',
                'bank': 'Bank Transfer',
                'ewallet': 'E-Wallet',
                'crypto': 'Cryptocurrency'
            };

            alert(`Payment will be processed via ${methodNames[selectedMethod.value]}. Thank you!`);
            closePaymentModal();
        }

        // Close modal when clicking outside
        document.getElementById('paymentModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closePaymentModal();
            }
        });

        // Add active state to payment method selection
        document.querySelectorAll('.payment-method').forEach(label => {
            label.addEventListener('click', function() {
                document.querySelectorAll('.payment-method').forEach(l => {
                    l.classList.remove('border-teal-500', 'bg-teal-50');
                });
                this.classList.add('border-teal-500', 'bg-teal-50');
            });
        });
    </script>
</body>
</html>