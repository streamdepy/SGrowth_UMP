<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Consultation Chat</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <div class="min-h-screen pb-8">
        <!-- Main Content Area -->
        <main class="max-w-7xl mx-auto mt-10 px-4">
            <div class="flex gap-6 max-md:flex-col">
                <!-- Session Timer Section -->
                <aside class="w-80 max-md:w-full">
                    <section class=" p-6 sticky top-4">
                        <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                            Session Time
                        </h2>

                        <!-- Timer Display -->
                        <div class="flex gap-3 justify-center mb-6">
                            <!-- Hours -->
                            <div class="flex flex-col items-center">
                                <div class="flex justify-center items-center w-20 h-20 text-3xl font-bold text-white bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl shadow-lg">
                                    <span id="hours" class="timer-hours">00</span>
                                </div>
                                <span class="text-sm text-gray-600 mt-2">Hours</span>
                            </div>

                            <div class="flex items-center text-3xl font-bold text-orange-500 pb-6">:</div>

                            <!-- Minutes -->
                            <div class="flex flex-col items-center">
                                <div class="flex justify-center items-center w-20 h-20 text-3xl font-bold text-white bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl shadow-lg">
                                    <span id="minutes" class="timer-minutes">55</span>
                                </div>
                                <span class="text-sm text-gray-600 mt-2">Minutes</span>
                            </div>

                            <div class="flex items-center text-3xl font-bold text-orange-500 pb-6">:</div>

                            <!-- Seconds -->
                            <div class="flex flex-col items-center">
                                <div class="flex justify-center items-center w-20 h-20 text-3xl font-bold text-white bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl shadow-lg">
                                    <span id="seconds" class="timer-seconds">55</span>
                                </div>
                                <span class="text-sm text-gray-600 mt-2">Seconds</span>
                            </div>
                        </div>

                        <!-- Session Info -->
                        <div class="bg-gray-50 rounded-lg p-4 mb-4">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm text-gray-600">Session Type</span>
                                <span class="text-sm font-semibold text-teal-700">Video Call</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-600">Duration</span>
                                <span class="text-sm font-semibold text-teal-700">1 Hour</span>
                            </div>
                        </div>

                        <!-- End Session Button -->
                        <a href="/mitra/konsultan" class="flex overflow-hidden gap-2.5 items-start self-center px-10 py-3 mt-7 text-base font-medium text-center text-orange-500 whitespace-nowrap bg-white rounded-xl border border-orange-500 border-solid max-md:px-5 hover:bg-orange-50 transition-colors">
                            Stop
                        </a>
                    </section>
                </aside>

                <!-- Chat Interface Section -->
                <section class="flex-1">
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col h-[700px]">
                        <!-- Chat Header -->
                        <header class="bg-white border-b border-gray-200 p-4">
                            <div class="flex justify-between items-center">
                                <!-- Consultant Info -->
                                <div class="flex gap-4 items-center">
                                    <div class="relative">
                                        <img
                                            src="https://api.builder.io/api/v1/image/assets/TEMP/e4ad899ce9a1bf41b43f681cab16d30e4156efc6?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                            alt="Consultant Avatar"
                                            class="w-16 h-16 rounded-full object-cover border-2 border-teal-500"
                                        />
                                    </div>
                                    <div>
                                        <h3 class="text-xl font-semibold text-teal-700">
                                            Dr. Budi Santosa, M.Si
                                        </h3>
                                        <p class="text-sm text-gray-500 flex items-center gap-1">
                                            <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                                            Online - Sustainability Analyst
                                        </p>
                                    </div>
                                </div>

                                <!-- Call Controls -->
                                <div class="flex gap-2">
                                    <button id="muteBtn" onclick="toggleMute()" class="p-3 bg-gray-100 rounded-xl hover:bg-gray-200 transition-colors" title="Mute/Unmute">
                                        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                                        </svg>
                                    </button>
                                    <button id="videoBtn" onclick="toggleVideo()" class="p-3 bg-gray-100 rounded-xl hover:bg-gray-200 transition-colors" title="Turn On/Off Video">
                                        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                        </svg>
                                    </button>
                                    <button onclick="endSession()" class="p-3 bg-red-500 rounded-xl hover:bg-red-600 transition-colors" title="End Call">
                                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.279 3H5z"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </header>

                        <!-- Chat Messages Area -->
                        <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4 bg-gray-50">
                            <!-- Consultant Message -->
                            <div class="flex gap-3 items-end">
                                <img
                                    src="https://api.builder.io/api/v1/image/assets/TEMP/bcba37ffb992fc3cf03e940e64040c7655bfe947?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                    alt="Dr. Budi Santosa"
                                    class="w-10 h-10 rounded-full object-cover flex-shrink-0"
                                />
                                <div class="flex-1 max-w-md">
                                    <p class="text-xs text-gray-500 mb-1">Dr. Budi Santosa</p>
                                    <div class="bg-white rounded-2xl rounded-bl-sm p-4 shadow-sm">
                                        <p class="text-gray-800">
                                            Hello! I'm Dr. Santosa. I'm ready to discuss your business sustainability concerns. How can I assist you today?
                                        </p>
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1">10:00 AM</p>
                                </div>
                            </div>

                            <!-- User Message -->
                            <div class="flex gap-3 items-end justify-end">
                                <div class="flex-1 max-w-md text-right">
                                    <p class="text-xs text-gray-500 mb-1">You</p>
                                    <div class="bg-gradient-to-br from-lime-500 to-lime-600 rounded-2xl rounded-br-sm p-4 shadow-md">
                                        <p class="text-white">
                                            Hi Dr. Santosa! I'm looking for guidance on implementing sustainable practices in my small agricultural business. I want to reduce environmental impact while maintaining profitability.
                                        </p>
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1">10:01 AM</p>
                                </div>
                                <img
                                    src="https://api.builder.io/api/v1/image/assets/TEMP/6eca9dd5e7d5c1607fea4f38faaa16d7850d3897?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                    alt="Your Avatar"
                                    class="w-10 h-10 rounded-full object-cover flex-shrink-0"
                                />
                            </div>

                            <!-- Consultant Message -->
                            <div class="flex gap-3 items-end">
                                <img
                                    src="https://api.builder.io/api/v1/image/assets/TEMP/bcba37ffb992fc3cf03e940e64040c7655bfe947?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                    alt="Dr. Budi Santosa"
                                    class="w-10 h-10 rounded-full object-cover flex-shrink-0"
                                />
                                <div class="flex-1 max-w-md">
                                    <p class="text-xs text-gray-500 mb-1">Dr. Budi Santosa</p>
                                    <div class="bg-white rounded-2xl rounded-bl-sm p-4 shadow-sm">
                                        <p class="text-gray-800">
                                            That's an excellent goal! Let's start by assessing your current operations. What type of agricultural products do you focus on, and what are your main environmental concerns?
                                        </p>
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1">10:02 AM</p>
                                </div>
                            </div>

                            <!-- Typing Indicator -->
                            <div id="typingIndicator" class="hidden flex gap-3 items-end">
                                <img
                                    src="https://api.builder.io/api/v1/image/assets/TEMP/bcba37ffb992fc3cf03e940e64040c7655bfe947?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                                    alt="Dr. Budi Santosa"
                                    class="w-10 h-10 rounded-full object-cover flex-shrink-0"
                                />
                                <div class="bg-white rounded-2xl rounded-bl-sm px-6 py-4 shadow-sm">
                                    <div class="flex gap-1">
                                        <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></span>
                                        <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></span>
                                        <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Message Input Area -->
                        <div class="bg-white border-t border-gray-200 p-4">
                            <div class="flex gap-3 items-center">
                                <button class="p-3 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-colors" title="Attach file">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                                    </svg>
                                </button>
                                
                                <div class="flex-1 relative">
                                    <input
                                        id="messageInput"
                                        type="text"
                                        placeholder="Type your message..."
                                        class="w-full px-4 py-3 bg-gray-100 rounded-xl border-none outline-none focus:ring-2 focus:ring-teal-500 transition-all"
                                    />
                                </div>

                                <button class="p-3 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-colors" title="Add emoji">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                </button>

                                <button id="sendBtn" onclick="sendMessage()" class="px-6 py-3 bg-gradient-to-r from-lime-500 to-lime-600 text-white rounded-xl hover:from-lime-600 hover:to-lime-700 transition-all shadow-md font-semibold flex items-center gap-2">
                                    <span>Send</span>
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script>
        // Session timer functionality
        let sessionTime = {
            hours: 0,
            minutes: 55,
            seconds: 55
        };

        let isMuted = false;
        let isVideoOff = false;

        function updateTimerDisplay() {
            document.getElementById('hours').textContent = sessionTime.hours.toString().padStart(2, '0');
            document.getElementById('minutes').textContent = sessionTime.minutes.toString().padStart(2, '0');
            document.getElementById('seconds').textContent = sessionTime.seconds.toString().padStart(2, '0');
        }

        function startTimer() {
            setInterval(() => {
                if (sessionTime.seconds > 0) {
                    sessionTime.seconds--;
                } else if (sessionTime.minutes > 0) {
                    sessionTime.minutes--;
                    sessionTime.seconds = 59;
                } else if (sessionTime.hours > 0) {
                    sessionTime.hours--;
                    sessionTime.minutes = 59;
                    sessionTime.seconds = 59;
                } else {
                    // Session ended
                    alert('Session time has ended!');
                }
                updateTimerDisplay();
            }, 1000);
        }

        function toggleMute() {
            isMuted = !isMuted;
            const btn = document.getElementById('muteBtn');
            if (isMuted) {
                btn.classList.add('bg-red-100');
                btn.classList.remove('bg-gray-100');
            } else {
                btn.classList.remove('bg-red-100');
                btn.classList.add('bg-gray-100');
            }
            console.log('Mute toggled:', isMuted);
        }

        function toggleVideo() {
            isVideoOff = !isVideoOff;
            const btn = document.getElementById('videoBtn');
            if (isVideoOff) {
                btn.classList.add('bg-red-100');
                btn.classList.remove('bg-gray-100');
            } else {
                btn.classList.remove('bg-red-100');
                btn.classList.add('bg-gray-100');
            }
            console.log('Video toggled:', isVideoOff);
        }

        function endSession() {
            if (confirm('Are you sure you want to end this consultation session?')) {
                alert('Session ended. Thank you for consulting with us!');
               window.location.href = '/mitra/history';
            }
        }

        function sendMessage() {
            const input = document.getElementById('messageInput');
            const message = input.value.trim();
            
            if (message) {
                const chatMessages = document.getElementById('chatMessages');
                const time = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                
                // Create new message element
                const messageDiv = document.createElement('div');
                messageDiv.className = 'flex gap-3 items-end justify-end';
                messageDiv.innerHTML = `
                    <div class="flex-1 max-w-md text-right">
                        <p class="text-xs text-gray-500 mb-1">You</p>
                        <div class="bg-gradient-to-br from-lime-500 to-lime-600 rounded-2xl rounded-br-sm p-4 shadow-md">
                            <p class="text-white">${message}</p>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">${time}</p>
                    </div>
                    <img
                        src="https://api.builder.io/api/v1/image/assets/TEMP/6eca9dd5e7d5c1607fea4f38faaa16d7850d3897?placeholderIfAbsent=true&apiKey=ac04cd396e1f47f18955cd19640f183d"
                        alt="Your Avatar"
                        class="w-10 h-10 rounded-full object-cover flex-shrink-0"
                    />
                `;
                
                chatMessages.appendChild(messageDiv);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                input.value = '';
                
                // Show typing indicator
                showTypingIndicator();
            }
        }

        function showTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            indicator.classList.remove('hidden');
            
            const chatMessages = document.getElementById('chatMessages');
            chatMessages.scrollTop = chatMessages.scrollHeight;
            
            // Hide after 2 seconds (simulate consultant typing)
            setTimeout(() => {
                indicator.classList.add('hidden');
            }, 2000);
        }

        // Enter key to send message
        document.getElementById('messageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        // Auto-scroll to bottom on load
        window.addEventListener('load', () => {
            const chatMessages = document.getElementById('chatMessages');
            chatMessages.scrollTop = chatMessages.scrollHeight;
        });

        // Start timer
        startTimer();
    </script>
</body>
</html>