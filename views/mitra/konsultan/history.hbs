                                    <div class="info-row flex items-center gap-2 mb-3 p-2 rounded-lg">
                                        <svg class="w-5 h-5 text-orange-500" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                        </svg>
                                        <span class="text-sm font-medium text-gray-700">Status:</span>
                                        <span class="bg-orange-100 text-orange-600 px-3 py-1 rounded-full text-sm font-bold">Ongoing</span>
                                    </div>

                                    <div class="info-row flex items-start gap-2 p-2 rounded-lg mb-5">
