<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Session Booking with Budi Santoso, M.Si</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white">
    <main class="flex flex-col items-start pt-10 mb-16 mx-auto my-0 max-w-[960px] w-full px-4 max-sm:pt-5">
        <section class="flex flex-wrap gap-y-3 justify-between content-start items-start self-stretch p-4">
            <div class="flex flex-col items-start min-w-72">
                <h2 class="self-stretch text-3xl font-bold leading-10 text-teal-700 max-sm:text-2xl max-sm:leading-8">
                    Session Booking with Budi Santoso, M.Si
                </h2>
                <p class="text-gray-600 mt-2">Select your preferred date and time for consultation</p>
            </div>
        </section>

        <section class="flex flex-col items-start self-stretch px-4 pt-4 pb-2">
            <h3 class="self-stretch text-lg font-bold leading-6 text-neutral-900 max-sm:text-base">
                Select a Date
            </h3>
        </section>

        <section class="flex flex-wrap gap-6 justify-center content-center items-start self-stretch p-4 max-md:flex-col max-md:gap-4 max-sm:p-2">
            <!-- July 2025 Calendar -->
            <div class="flex flex-col gap-2 items-start flex-1 max-w-[400px] min-w-[280px] bg-white rounded-xl shadow-sm p-4">
                <div class="flex justify-between items-center self-stretch mb-2">
                    <button id="prevMonth" class="flex justify-center items-center w-10 h-10 rounded-full hover:bg-gray-100 transition-colors" aria-label="Previous month">
                        <svg width="18" height="18" viewBox="0 0 7 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M6.64797 12.227C6.86776 12.4468 6.86776 12.8032 6.64797 13.023C6.42818 13.2428 6.07182 13.2428 5.85203 13.023L0.227031 7.39797C0.121407 7.29246 0.0620575 7.14929 0.0620575 7C0.0620575 6.85071 0.121407 6.70754 0.227031 6.60203L5.85203 0.977031C6.07182 0.757239 6.42818 0.757239 6.64797 0.977031C6.86776 1.19682 6.86776 1.55318 6.64797 1.77297L1.42023 7L6.64797 12.227Z" fill="#121417"/>
                        </svg>
                    </button>
                    <h4 id="currentMonth" class="text-base font-bold text-neutral-900">July 2025</h4>
                    <button id="nextMonth" class="flex justify-center items-center w-10 h-10 rounded-full hover:bg-gray-100 transition-colors" aria-label="Next month">
                        <svg width="18" height="18" viewBox="0 0 7 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M6.77297 7.39797L1.14797 13.023C0.928177 13.2428 0.571823 13.2428 0.352031 13.023C0.132239 12.8032 0.132239 12.4468 0.352031 12.227L5.57977 7L0.352031 1.77297C0.132239 1.55318 0.132239 1.19682 0.352031 0.977031C0.571823 0.757239 0.928177 0.757239 1.14797 0.977031L6.77297 6.60203C6.87859 6.70754 6.93794 6.85071 6.93794 7C6.93794 7.14929 6.87859 7.29246 6.77297 7.39797Z" fill="#121417"/>
                        </svg>
                    </button>
                </div>

                <div class="flex flex-col items-start self-stretch">
                    <!-- Days of week header -->
                    <div class="grid grid-cols-7 gap-1 w-full mb-1">
                        <div class="flex justify-center items-center h-10">
                            <span class="text-sm font-bold text-gray-500">Sun</span>
                        </div>
                        <div class="flex justify-center items-center h-10">
                            <span class="text-sm font-bold text-gray-500">Mon</span>
                        </div>
                        <div class="flex justify-center items-center h-10">
                            <span class="text-sm font-bold text-gray-500">Tue</span>
                        </div>
                        <div class="flex justify-center items-center h-10">
                            <span class="text-sm font-bold text-gray-500">Wed</span>
                        </div>
                        <div class="flex justify-center items-center h-10">
                            <span class="text-sm font-bold text-gray-500">Thu</span>
                        </div>
                        <div class="flex justify-center items-center h-10">
                            <span class="text-sm font-bold text-gray-500">Fri</span>
                        </div>
                        <div class="flex justify-center items-center h-10">
                            <span class="text-sm font-bold text-gray-500">Sat</span>
                        </div>
                    </div>

                    <!-- Calendar dates will be inserted here by JavaScript -->
                    <div id="calendarDates" class="grid grid-cols-7 gap-1 w-full"></div>
                </div>
            </div>
        </section>

        <section class="flex flex-col items-start self-stretch px-4 pt-4 pb-2">
            <h3 class="self-stretch text-lg font-bold leading-6 text-neutral-900 max-sm:text-base">
                Select Time
            </h3>
            <p class="text-sm text-gray-500 mt-1">Please select a date first</p>
        </section>

        <section class="flex flex-wrap gap-3 content-start items-start self-stretch p-4 max-sm:p-2">
            <button class="time-slot flex items-center px-6 py-2 border border-gray-300 cursor-pointer bg-slate-50 rounded-full hover:bg-teal-50 hover:border-teal-300 transition-all">
                <span class="text-sm font-medium text-teal-700">9:00 AM</span>
            </button>
            <button class="time-slot flex items-center px-6 py-2 border border-gray-300 cursor-pointer bg-slate-50 rounded-full hover:bg-teal-50 hover:border-teal-300 transition-all">
                <span class="text-sm font-medium text-teal-700">10:00 AM</span>
            </button>
            <button class="time-slot flex items-center px-6 py-2 border border-gray-300 cursor-pointer bg-slate-50 rounded-full hover:bg-teal-50 hover:border-teal-300 transition-all">
                <span class="text-sm font-medium text-teal-700">11:00 AM</span>
            </button>
            <button class="time-slot flex items-center px-6 py-2 border border-gray-300 cursor-pointer bg-slate-50 rounded-full hover:bg-teal-50 hover:border-teal-300 transition-all">
                <span class="text-sm font-medium text-teal-700">1:00 PM</span>
            </button>
            <button class="time-slot flex items-center px-6 py-2 border border-gray-300 cursor-pointer bg-slate-50 rounded-full hover:bg-teal-50 hover:border-teal-300 transition-all">
                <span class="text-sm font-medium text-teal-700">2:00 PM</span>
            </button>
            <button class="time-slot flex items-center px-6 py-2 border border-gray-300 cursor-pointer bg-slate-50 rounded-full hover:bg-teal-50 hover:border-teal-300 transition-all">
                <span class="text-sm font-medium text-teal-700">3:00 PM</span>
            </button>
        </section>

        <section class="flex flex-col items-start self-stretch px-4 pt-4 pb-2">
            <h3 class="self-stretch text-lg font-bold leading-6 text-neutral-900 max-sm:text-base">
                Time Zones
            </h3>
        </section>

        <section class="flex flex-col gap-6 items-start self-stretch p-4 max-sm:p-2">
            <div class="flex gap-6 items-start self-stretch flex-wrap">
                <div class="flex flex-col items-start flex-1 min-w-[200px] px-0 py-5 border-t border-solid border-t-gray-200">
                    <span class="text-sm leading-5 text-slate-500 mb-1">Your Time Zone</span>
                    <span class="text-sm font-medium leading-5 text-neutral-900">(GMT+7) Jakarta, Indonesia</span>
                </div>
                <div class="flex flex-col items-start flex-1 min-w-[200px] px-0 py-5 border-t border-solid border-t-gray-200">
                    <span class="text-sm leading-5 text-slate-500 mb-1">Consultant's Time Zone</span>
                    <span class="text-sm font-medium leading-5 text-neutral-900">(GMT-4) New York, USA</span>
                </div>
            </div>
        </section>

        <section class="flex justify-between items-center self-stretch px-4 py-4 max-sm:flex-col max-sm:gap-4">
            <div id="selectedInfo" class="text-sm text-gray-600">
                No date and time selected
            </div>
            <button id="confirmBtn" disabled class="flex gap-2.5 justify-center items-center px-12 py-3.5 bg-orange-500 rounded-full cursor-pointer border-none hover:bg-orange-600 transition-all disabled:bg-gray-300 disabled:cursor-not-allowed max-sm:w-full">
                <span class="text-base font-semibold text-white">Proceed to Payment</span>
            </button>
        </section>
    </main>

    <script>
        let currentMonth = 6; // July (0-indexed)
        let currentYear = 2025;
        let selectedDate = null;
        let selectedTime = null;

        const monthNames = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"];

        function generateCalendar(month, year) {
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const calendarDates = document.getElementById('calendarDates');
            const monthDisplay = document.getElementById('currentMonth');
            
            calendarDates.innerHTML = '';
            monthDisplay.textContent = `${monthNames[month]} ${year}`;

            // Add empty cells for days before the first day of the month
            for (let i = 0; i < firstDay; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'h-10';
                calendarDates.appendChild(emptyCell);
            }

            // Add days of the month
            for (let day = 1; day <= daysInMonth; day++) {
                const dateBtn = document.createElement('button');
                dateBtn.className = 'date-btn flex justify-center items-center h-10 w-full rounded-full hover:bg-teal-100 transition-all';
                dateBtn.innerHTML = `<span class="text-sm text-neutral-900">${day}</span>`;
                dateBtn.dataset.date = `${year}-${month + 1}-${day}`;
                
                dateBtn.addEventListener('click', function() {
                    document.querySelectorAll('.date-btn').forEach(btn => {
                        btn.classList.remove('bg-teal-500', 'text-white');
                        btn.querySelector('span').classList.remove('text-white');
                        btn.querySelector('span').classList.add('text-neutral-900');
                    });
                    
                    this.classList.add('bg-teal-500');
                    this.querySelector('span').classList.remove('text-neutral-900');
                    this.querySelector('span').classList.add('text-white');
                    
                    selectedDate = this.dataset.date;
                    updateSelectedInfo();
                });
                
                calendarDates.appendChild(dateBtn);
            }
        }

        document.getElementById('prevMonth').addEventListener('click', () => {
            currentMonth--;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            }
            generateCalendar(currentMonth, currentYear);
        });

        document.getElementById('nextMonth').addEventListener('click', () => {
            currentMonth++;
            if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            generateCalendar(currentMonth, currentYear);
        });

        document.querySelectorAll('.time-slot').forEach(button => {
            button.addEventListener('click', function() {
                document.querySelectorAll('.time-slot').forEach(btn => {
                    btn.classList.remove('bg-teal-500', 'border-teal-500');
                    btn.classList.add('bg-slate-50', 'border-gray-300');
                    btn.querySelector('span').classList.remove('text-white');
                    btn.querySelector('span').classList.add('text-teal-700');
                });
                
                this.classList.remove('bg-slate-50', 'border-gray-300');
                this.classList.add('bg-teal-500', 'border-teal-500');
                this.querySelector('span').classList.remove('text-teal-700');
                this.querySelector('span').classList.add('text-white');
                
                selectedTime = this.querySelector('span').textContent;
                updateSelectedInfo();
            });
        });

        function updateSelectedInfo() {
            const infoDiv = document.getElementById('selectedInfo');
            const confirmBtn = document.getElementById('confirmBtn');
            
            if (selectedDate && selectedTime) {
                const date = new Date(selectedDate);
                const formattedDate = date.toLocaleDateString('en-US', { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
                infoDiv.innerHTML = `<strong>Selected:</strong> ${formattedDate} at ${selectedTime}`;
                confirmBtn.disabled = false;
            } else if (selectedDate) {
                infoDiv.textContent = 'Please select a time slot';
                confirmBtn.disabled = true;
            } else {
                infoDiv.textContent = 'No date and time selected';
                confirmBtn.disabled = true;
            }
        }

        document.getElementById('confirmBtn').addEventListener('click', () => {
            if (selectedDate && selectedTime) {
                alert(`Booking confirmed for ${selectedDate} at ${selectedTime}`);
                window.location.href = '/mitra/bookingSummary';
            }
        });

        // Initialize calendar
        generateCalendar(currentMonth, currentYear);
    </script>
</body>
</html>