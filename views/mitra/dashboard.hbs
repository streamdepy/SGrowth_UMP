                    <!-- Article 3 -->
                    <div class="bg-white rounded-2xl overflow-hidden shadow-xl card-hover">
                        <div class="h-48 overflow-hidden">
                            <img src="https://i.guim.co.uk/img/media/8c594b171a40e318a2773576e90485bc3ab13c4e/0_179_3500_2099/master/3500.jpg?width=620&dpr=1&s=none&crop=none" 
                                 class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-500" 
                                 alt="HSBC Climate" />
                        </div>
                        <div class="p-6">
                            <span class="inline-block bg-orange-100 text-orange-600 text-xs font-bold px-3 py-1 rounded-full mb-3">Article</span>
                            <h3 class="text-lg font-bold text-gray-800 mb-3 line-clamp-2">Watchdog bans HSBC climate ads in fresh blow to bank's green credentials</h3>
                            <a href="https://www.theguardian.com/business/2022/oct/19/watchdog-bans-hsbc-ads-green-cop26-climate-crisis" 
                               target="_blank" 
                               class="inline-flex items-center gap-2 text-orange-500 font-semibold hover:text-orange-600 transition-colors">
                                Read More
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </div>
                    </div>

