                                            <span class="text-sm font-semibold text-gray-600 bg-gray-50 px-2 py-1 rounded">Wed, Aug 15, 2025 • 09:00-11:00</span>
                                        </div>
                                    </div>

                                    <button class="w-full bg-gray-400 text-white font-semibold py-3 px-6 rounded-xl cursor-not-allowed opacity-75" disabled>
                                        <span class="flex items-center justify-center gap-2">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                            </svg>
                                            Completed
                                        </span>
                                    </button>

                                    <div class="mt-4 p-3 bg-amber-50 rounded-lg border border-amber-200">
                                        <p class="text-sm font-medium text-gray-700 mb-2">Your Rating:</p>
                                        <div class="flex gap-1">
                                            <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
