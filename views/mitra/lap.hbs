            <p class="text-2xl opacity-90">PT Maju Sejahtera Indonesia</p>
            <p class="text-lg opacity-75 mt-2">Reporting Period: 2024</p>
        </div>

        <!-- Company Identity Section -->
        <div class="p-12 border-b-4 border-teal-100">
            <h2 class="text-3xl font-bold text-teal-700 mb-8 pb-3 border-b-2 border-teal-200">Company Identity</h2>
            
            <div class="grid grid-cols-2 gap-8">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Company Name</p>
                    <p class="text-xl font-semibold text-gray-800">PT Maju Sejahtera Indonesia</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Business Sector</p>
                    <p class="text-xl font-semibold text-gray-800">Manufacturing</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Business License Number</p>
                    <p class="text-xl font-semibold text-gray-800">NIB-1234567890123</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Legal Form</p>
                    <p class="text-xl font-semibold text-gray-800">Legal Entity (PT)</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Ownership Type</p>
                    <p class="text-xl font-semibold text-gray-800">Private</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Headquarters Location</p>
                    <p class="text-xl font-semibold text-gray-800">Jakarta Selatan, DKI Jakarta</p>
                </div>
            </div>

            <!-- Share Ownership Chart -->
            <div class="mt-12">
                <h3 class="text-2xl font-bold text-teal-700 mb-6">Share Ownership</h3>
                <div class="grid grid-cols-2 gap-8 items-center">
                    <div class="relative h-80">
                        <canvas id="ownershipChart"></canvas>
                    </div>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between p-4 bg-blue-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-blue-600 rounded mr-3"></div>
                                <span class="font-medium">PT Induk Investasi</span>
                            </div>
                            <span class="font-bold text-blue-600">45%</span>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-teal-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-teal-600 rounded mr-3"></div>
                                <span class="font-medium">Budi Santoso</span>
                            </div>
                            <span class="font-bold text-teal-600">30%</span>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-orange-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-orange-600 rounded mr-3"></div>
                                <span class="font-medium">Siti Rahma</span>
                            </div>
                            <span class="font-bold text-orange-600">15%</span>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-purple-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-purple-600 rounded mr-3"></div>
                                <span class="font-medium">Ahmad Wijaya</span>
                            </div>
                            <span class="font-bold text-purple-600">10%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Countries of Operation -->
            <div class="mt-12">
                <h3 class="text-2xl font-bold text-teal-700 mb-4">Countries of Operation</h3>
                <div class="flex flex-wrap gap-3">
                    <span class="px-4 py-2 bg-teal-100 text-teal-700 rounded-full font-medium">🇮🇩 Indonesia</span>
                    <span class="px-4 py-2 bg-teal-100 text-teal-700 rounded-full font-medium">🇸🇬 Singapore</span>
                    <span class="px-4 py-2 bg-teal-100 text-teal-700 rounded-full font-medium">🇲🇾 Malaysia</span>
                </div>
            </div>

            <!-- Controlled Entities -->
            <div class="mt-8">
                <h3 class="text-2xl font-bold text-teal-700 mb-4">Controlled Entities</h3>
                <div class="flex flex-wrap gap-3">
                    <span class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-medium">Anak Perusahaan</span>
                    <span class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-medium">Afiliasi</span>
                </div>
            </div>

            <!-- External Assurance -->
            <div class="mt-8">
                <h3 class="text-2xl font-bold text-teal-700 mb-4">External Assurance</h3>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse">
                        <thead class="bg-teal-700 text-white">
                            <tr>
                                <th class="px-6 py-3 text-left">Assurer Name</th>
                                <th class="px-6 py-3 text-left">ID Assurer</th>
                                <th class="px-6 py-3 text-left">Expertise Level</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4">KAP Ernst & Young Indonesia</td>
                                <td class="px-6 py-4">AP-001234</td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="w-full bg-gray-200 rounded-full h-2 mr-3">
                                            <div class="bg-teal-600 h-2 rounded-full" style="width: 95%"></div>
                                        </div>
                                        <span class="font-bold text-teal-600">95%</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Industry & Product Information -->
        <div class="p-12 border-b-4 border-teal-100 page-break">
            <h2 class="text-3xl font-bold text-teal-700 mb-8 pb-3 border-b-2 border-teal-200">Industry & Product Information</h2>
            
            <div class="grid grid-cols-2 gap-8 mb-8">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Main Industry Type</p>
                    <p class="text-xl font-semibold text-gray-800">Manufacturing</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Quantity of Products</p>
                    <p class="text-xl font-semibold text-gray-800">250,000 units/year</p>
                </div>
            </div>

            <div class="mb-8">
                <p class="text-sm text-gray-500 mb-2">Organization Activities</p>
                <p class="text-base text-gray-700 leading-relaxed">Manufacturing of consumer electronics, specializing in smart home devices and IoT solutions. Our operations include product design, assembly, quality control, and distribution across Southeast Asian markets.</p>
            </div>

            <!-- Geographical Locations -->
            <div class="mt-8">
                <h3 class="text-2xl font-bold text-teal-700 mb-4">Geographical Locations</h3>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse">
                        <thead class="bg-teal-700 text-white">
                            <tr>
                                <th class="px-6 py-3 text-left">Street</th>
                                <th class="px-6 py-3 text-left">City</th>
                                <th class="px-6 py-3 text-left">Country</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4">Jl. Industri Raya No. 45</td>
                                <td class="px-6 py-4">Jakarta</td>
                                <td class="px-6 py-4">Indonesia</td>
                            </tr>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4">Kawasan Industri MM2100 Blok A-5</td>
                                <td class="px-6 py-4">Bekasi</td>
                                <td class="px-6 py-4">Indonesia</td>
                            </tr>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4">12 Changi Business Park</td>
                                <td class="px-6 py-4">Singapore</td>
                                <td class="px-6 py-4">Singapore</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Supplier Information -->
            <div class="mt-12">

        <h3 class="text-3xl font-bold text-teal-700 mb-8">Supplier Information</h3>
        
        <!-- Total and Breakdown -->
        <div class="grid lg:grid-cols-3 gap-6 mb-8">
            <!-- Total Suppliers -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 animate-fadeIn">
                <p class="text-sm font-medium text-gray-600 mb-2">Total Suppliers</p>
                <p class="text-5xl font-bold text-blue-700 mb-1">124</p>
                <p class="text-xs text-gray-500">Active partnerships</p>
            </div>

            <!-- Supplier Types Distribution -->
            <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-lg animate-fadeIn" style="animation-delay: 0.1s;">
                <p class="text-sm font-semibold text-gray-700 mb-4">Supplier Types Distribution</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <!-- Wholesaler -->
                    <div class="bg-gradient-to-br from-teal-50 to-teal-100 p-4 rounded-lg hover:scale-105 transition-transform duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-teal-700">Wholesaler</span>
                            <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                            </svg>
                        </div>
                        <p class="text-3xl font-bold text-teal-700">52</p>
                        <p class="text-xs text-teal-600 mt-1">41.9% of total</p>
                    </div>

                    <!-- Contractor -->
                    <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 p-4 rounded-lg hover:scale-105 transition-transform duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-indigo-700">Contractor</span>
                            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                            </svg>
                        </div>
                        <p class="text-3xl font-bold text-indigo-700">45</p>
                        <p class="text-xs text-indigo-600 mt-1">36.3% of total</p>
                    </div>

                    <!-- Broker -->
                    <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-4 rounded-lg hover:scale-105 transition-transform duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-amber-700">Broker</span>
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                        </div>
                        <p class="text-3xl font-bold text-amber-700">27</p>
                        <p class="text-xs text-amber-600 mt-1">21.8% of total</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Supplier Relationships -->
        <div class="bg-white p-6 rounded-xl shadow-lg animate-fadeIn" style="animation-delay: 0.2s;">
            <p class="text-sm font-semibold text-gray-700 mb-4">Supplier Relationships</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <!-- Long-Term -->
                <div class="bg-gradient-to-br from-purple-50 to-purple-100 p-5 rounded-lg border-l-4 border-purple-500 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 bg-purple-200 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-purple-700">Long-Term</p>
                            <p class="text-xs text-purple-600">Partnership</p>
                        </div>
                    </div>
                    <p class="text-3xl font-bold text-purple-700 mb-1">68</p>
                    <p class="text-xs text-purple-600">54.8% of suppliers</p>
                </div>

                <!-- Contract -->
                <div class="bg-gradient-to-br from-pink-50 to-pink-100 p-5 rounded-lg border-l-4 border-pink-500 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 bg-pink-200 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-pink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-pink-700">Contract</p>
                            <p class="text-xs text-pink-600">Based</p>
                        </div>
                    </div>
                    <p class="text-3xl font-bold text-pink-700 mb-1">38</p>
                    <p class="text-xs text-pink-600">30.6% of suppliers</p>
                </div>

                <!-- Project-Based -->
                <div class="bg-gradient-to-br from-cyan-50 to-cyan-100 p-5 rounded-lg border-l-4 border-cyan-500 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 bg-cyan-200 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-cyan-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-cyan-700">Project-Based</p>
                            <p class="text-xs text-cyan-600">Temporary</p>
                        </div>
                    </div>
                    <p class="text-3xl font-bold text-cyan-700 mb-1">18</p>
                    <p class="text-xs text-cyan-600">14.5% of suppliers</p>
                </div>
            </div>
        </div>

        <!-- Summary Stats -->
        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 animate-fadeIn" style="animation-delay: 0.3s;">
            <div class="bg-white p-4 rounded-lg shadow text-center">
                <p class="text-sm text-gray-600 mb-1">Avg. Partnership</p>
                <p class="text-2xl font-bold text-teal-700">3.2 years</p>
            </div>
            <div class="bg-white p-4 rounded-lg shadow text-center">
                <p class="text-sm text-gray-600 mb-1">Active Projects</p>
                <p class="text-2xl font-bold text-teal-700">47</p>
            </div>
            <div class="bg-white p-4 rounded-lg shadow text-center">
                <p class="text-sm text-gray-600 mb-1">New This Month</p>
                <p class="text-2xl font-bold text-green-600">+8</p>
            </div>
            <div class="bg-white p-4 rounded-lg shadow text-center">
                <p class="text-sm text-gray-600 mb-1">Response Rate</p>
                <p class="text-2xl font-bold text-teal-700">94%</p>
            </div>
        </div>
    
            </div>
        </div>

        <!-- Employee & Worker Information -->
        <div class="p-12 border-b-4 border-teal-100 page-break">
            <h2 class="text-3xl font-bold text-teal-700 mb-8 pb-3 border-b-2 border-teal-200">Employee & Worker Information</h2>
            
            <div class="bg-gradient-to-r from-teal-50 to-blue-50 p-8 rounded-xl mb-8">
                <p class="text-sm text-gray-600 mb-2">Total Workforce</p>
                <p class="text-5xl font-bold text-teal-700">1,247</p>
                <p class="text-sm text-gray-500 mt-2">As of December 31, 2024</p>
            </div>

            <!-- Gender Composition -->
            <div class="mb-12">
                <h3 class="text-2xl font-bold text-teal-700 mb-6">Gender Composition</h3>
                <div class="grid grid-cols-2 gap-8 items-center">
                    <div class="relative h-64">
                        <canvas id="genderChart"></canvas>
                    </div>
                    <div class="space-y-4">
                        <div class="bg-blue-50 p-6 rounded-xl">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-lg font-semibold text-gray-700">Male</span>
                                <span class="text-3xl font-bold text-blue-600">58%</span>
                            </div>
                            <p class="text-gray-600">723 employees</p>
                        </div>
                        <div class="bg-pink-50 p-6 rounded-xl">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-lg font-semibold text-gray-700">Female</span>
                                <span class="text-3xl font-bold text-pink-600">42%</span>
                            </div>
                            <p class="text-gray-600">524 employees</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Workforce Breakdown -->
            <div class="mt-12">
                <h3 class="text-2xl font-bold text-teal-700 mb-6">Workforce Breakdown</h3>
                <div class="grid grid-cols-2 gap-8">
                    <div class="relative h-80">
                        <canvas id="workforceChart"></canvas>
                    </div>
                    <div class="space-y-3">
                        <div class="bg-gradient-to-r from-blue-50 to-blue-100 p-4 rounded-lg">
                            <div class="flex justify-between items-center">
                                <span class="font-medium text-gray-700">Full-time Employees</span>
                                <div class="text-right">
                                    <p class="text-2xl font-bold text-blue-600">1,050</p>
                                    <p class="text-sm text-gray-600">84.2%</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gradient-to-r from-teal-50 to-teal-100 p-4 rounded-lg">
                            <div class="flex justify-between items-center">
                                <span class="font-medium text-gray-700">Part-time Employees</span>
                                <div class="text-right">
                                    <p class="text-2xl font-bold text-teal-600">87</p>
                                    <p class="text-sm text-gray-600">7.0%</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gradient-to-r from-orange-50 to-orange-100 p-4 rounded-lg">
                            <div class="flex justify-between items-center">
                                <span class="font-medium text-gray-700">Flexible Hours</span>
                                <div class="text-right">
                                    <p class="text-2xl font-bold text-orange-600">75</p>
                                    <p class="text-sm text-gray-600">6.0%</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gradient-to-r from-purple-50 to-purple-100 p-4 rounded-lg">
                            <div class="flex justify-between items-center">
                                <span class="font-medium text-gray-700">Temporary Employees</span>
                                <div class="text-right">
                                    <p class="text-2xl font-bold text-purple-600">35</p>
                                    <p class="text-sm text-gray-600">2.8%</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Temporary Employment Context -->
            <div class="mt-8 bg-gray-50 p-6 rounded-xl">
                <h4 class="font-semibold text-gray-700 mb-3">Temporary Employment Context</h4>
                <p class="text-gray-600 leading-relaxed">Temporary employees are primarily hired for seasonal production peaks (Q3-Q4) and specific project implementations. This arrangement allows flexibility in managing production capacity while maintaining cost efficiency during lower demand periods.</p>
            </div>
        </div>

        <!-- Non-Direct Workers -->
        <div class="p-12 page-break">
            <h2 class="text-3xl font-bold text-teal-700 mb-8 pb-3 border-b-2 border-teal-200">Non-Direct Workers</h2>
            
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead class="bg-teal-700 text-white">
                        <tr>
                            <th class="px-6 py-3 text-left">Worker Type</th>
                            <th class="px-6 py-3 text-left">Contract Type</th>
                            <th class="px-6 py-3 text-right">Count</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 font-medium">Contractors</td>
                            <td class="px-6 py-4"><span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm">Project-Based</span></td>
                            <td class="px-6 py-4 text-right font-bold">145</td>
                        </tr>
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 font-medium">Agency Workers</td>
                            <td class="px-6 py-4"><span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm">Temporary</span></td>
                            <td class="px-6 py-4 text-right font-bold">89</td>
                        </tr>
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 font-medium">Long-term Interns</td>
                            <td class="px-6 py-4"><span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm">Fixed-Term</span></td>
                            <td class="px-6 py-4 text-right font-bold">28</td>
                        </tr>
                        <tr class="hover:bg-gray-50">
