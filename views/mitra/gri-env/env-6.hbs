<main class="flex flex-col ml-48 self-center mb-16 mt-16 w-full max-w-[1256px] max-md:mt-10 max-md:max-w-full">
  <header class="flex gap-3.5 self-start">
    <img
      src="https://api.builder.io/api/v1/image/assets/TEMP/1c71a2a9be3de365531c3991c3339c7e3c083b53?width=462"
      alt="GRI Environment icon"
      class="object-contain shrink-0 my-auto rounded-full aspect-[1.04] w-[58px]"
    />
    <div class="flex flex-col">
      <h2 class="text-4xl font-semibold text-black">GRI Environment</h2>
      <p class="self-center text-xl font-medium leading-none text-center text-gray-500">
        Environmental Performance
      </p>
    </div>
  </header>

  <form action="/mitra/form-gri" method="GET">
    <!-- Ozone-Depleting Substances (ODS) Emissions (305-6) -->
<!-- Significant Air Emissions (305-7) -->
<section class="flex flex-col items-start py-14 px-16 mt-10 w-full bg-white rounded-2xl shadow-2xl max-w-[981px] max-md:px-5">
  <h3 class="text-3xl font-semibold text-teal-700">
    Nitrogen oxides (NOx), sulfur oxides (SOx), and other significant air emissions (305-7)
  </h3>
  <p class="mt-3 text-gray-500">
    Report significant air emissions, in kilograms or multiples, for each of the categories below and provide the 
    source of emission factors and calculation methodologies used.
  </p>

  <!-- Significant air emissions by category -->
  <div class="w-full mt-8">
    <label class="block pb-2 text-base font-medium">
      Significant air emissions by category (in kilograms or multiples)
    </label>
    <p class="text-gray-500 text-sm mb-4">
      Enter the quantity of significant air emissions for each pollutant category during the reporting period.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- NOx -->
      <div>
        <label for="emissions_nox" class="block text-sm font-medium text-gray-700">
          Nitrogen oxides (NOx)
        </label>
        <div class="mt-2 flex items-center gap-3">
          <input
            type="number"
            min="0"
            step="0.01"
            id="emissions_nox"
            name="emissions_nox"
            placeholder="0.00"
            class="w-full px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
          />
          <span class="text-sm text-gray-500 whitespace-nowrap">kg</span>
        </div>
      </div>

      <!-- SOx -->
      <div>
        <label for="emissions_sox" class="block text-sm font-medium text-gray-700">
          Sulfur oxides (SOx)
        </label>
        <div class="mt-2 flex items-center gap-3">
          <input
            type="number"
            min="0"
            step="0.01"
            id="emissions_sox"
            name="emissions_sox"
            placeholder="0.00"
            class="w-full px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
          />
          <span class="text-sm text-gray-500 whitespace-nowrap">kg</span>
        </div>
      </div>

      <!-- POP -->
      <div>
        <label for="emissions_pop" class="block text-sm font-medium text-gray-700">
          Persistent organic pollutants (POP)
        </label>
        <div class="mt-2 flex items-center gap-3">
          <input
            type="number"
            min="0"
            step="0.01"
            id="emissions_pop"
            name="emissions_pop"
            placeholder="0.00"
            class="w-full px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
          />
          <span class="text-sm text-gray-500 whitespace-nowrap">kg</span>
        </div>
      </div>

      <!-- VOC -->
      <div>
        <label for="emissions_voc" class="block text-sm font-medium text-gray-700">
          Volatile organic compounds (VOC)
        </label>
        <div class="mt-2 flex items-center gap-3">
          <input
            type="number"
            min="0"
            step="0.01"
            id="emissions_voc"
            name="emissions_voc"
            placeholder="0.00"
            class="w-full px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
          />
          <span class="text-sm text-gray-500 whitespace-nowrap">kg</span>
        </div>
      </div>

      <!-- HAP -->
      <div>
        <label for="emissions_hap" class="block text-sm font-medium text-gray-700">
          Hazardous air pollutants (HAP)
        </label>
        <div class="mt-2 flex items-center gap-3">
          <input
            type="number"
            min="0"
            step="0.01"
            id="emissions_hap"
            name="emissions_hap"
            placeholder="0.00"
            class="w-full px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
          />
          <span class="text-sm text-gray-500 whitespace-nowrap">kg</span>
        </div>
      </div>

      <!-- PM -->
      <div>
        <label for="emissions_pm" class="block text-sm font-medium text-gray-700">
          Particulate matter (PM)
        </label>
        <div class="mt-2 flex items-center gap-3">
          <input
            type="number"
            min="0"
            step="0.01"
            id="emissions_pm"
            name="emissions_pm"
            placeholder="0.00"
            class="w-full px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
          />
          <span class="text-sm text-gray-500 whitespace-nowrap">kg</span>
        </div>
      </div>

      <!-- Other standard categories -->
      <div class="md:col-span-2">
        <label for="emissions_other" class="block text-sm font-medium text-gray-700">
          Other standard categories of air emissions
        </label>
        <div class="mt-2 flex flex-col gap-3 md:flex-row md:items-center">
          <input
            type="text"
            id="emissions_other_name"
            name="emissions_other_name"
            placeholder="e.g. Ammonia (NH₃), Carbon monoxide (CO)"
            class="w-full md:w-2/3 px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
          />
          <div class="flex items-center gap-3 w-full md:w-1/3">
            <input
              type="number"
              min="0"
              step="0.01"
              id="emissions_other"
              name="emissions_other"
              placeholder="0.00"
              class="w-full px-6 py-3 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
            />
            <span class="text-sm text-gray-500 whitespace-nowrap">kg</span>
          </div>
        </div>
        <p class="mt-2 text-gray-500 text-sm">
          Specify other standard air emission categories identified in relevant regulations, if applicable.
        </p>
      </div>
    </div>
  </div>

  <!-- Source of emission factors used -->
  <div class="w-full mt-10">
    <label for="emission_factor_source" class="block pb-2 text-base font-medium">
      Source of the emission factors used
    </label>
    <textarea
      id="emission_factor_source"
      name="emission_factor_source"
      rows="3"
      placeholder="e.g. National emission factor database, IPCC guidelines, sector-specific technical guidance, internal measurements."
      class="w-full px-8 py-4 mt-2 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
    ></textarea>
    <p class="mt-2 text-gray-500 text-sm">
      Describe the primary sources of the emission factors applied (e.g. regulatory databases, IPCC, supplier data, or internal studies).
    </p>
  </div>

  <!-- Standards, methodologies, assumptions, and/or calculation tools used -->
  <div class="w-full mt-8">
    <label for="emission_methods" class="block pb-2 text-base font-medium">
      Standards, methodologies, assumptions, and/or calculation tools used
    </label>
    <textarea
      id="emission_methods"
      name="emission_methods"
      rows="4"
      placeholder="Describe the reporting standards (e.g. GRI, ISO), calculation methodologies, key assumptions (e.g. operating hours, load factors), and tools or software used."
      class="w-full px-8 py-4 mt-2 text-base text-black rounded-2xl border border-gray-300 bg-slate-50 outline-none hover:ring focus:ring-2 focus:ring-teal-600 transition"
    ></textarea>
    <p class="mt-2 text-gray-500 text-sm">
      Include any relevant standards (e.g. GRI 305, ISO 14064), calculation approaches, emission models, and key assumptions or limitations.
    </p>
  </div>

        <!-- Right corner buttons -->
      <div class="flex justify-end gap-4 mt-10 w-full">
        <button type="button" onclick="window.history.back()"
          class="px-8 py-2 text-base font-medium text-center text-teal-700 border-teal-700 border border-solid whitespace-nowrap bg-white rounded-xl hover:bg-teal-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors">
          Previous
        </button>
        <a href="/mitra/form-gri"
       type="submit"
          class="px-8 py-2 text-base font-medium text-center text-white whitespace-nowrap bg-lime-500 rounded-xl hover:bg-lime-600 focus:outline-none focus:ring-2 focus:ring-lime-500 focus:ring-offset-2 transition-colors">
          Save
        </a>
      </div>
</section>

  </form>
</main>

<script>
// Update the total ODS emissions summary
const odsEmissionsInput = document.getElementById('ods_emissions');
function updateOdsTotal() {
  const odsEmissions = parseFloat(odsEmissionsInput.value) || 0;
  document.getElementById('total_ods_emissions').innerText = odsEmissions.toFixed(4);
}

odsEmissionsInput.addEventListener('input', updateOdsTotal);
</script>
