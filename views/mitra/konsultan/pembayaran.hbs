    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Main Content -->
    <main class="flex flex-wrap gap-5 justify-between mt-20 ml-36 w-full max-w-[1283px] max-md:mt-10 max-md:ml-4 max-md:mr-4 max-md:max-w-full">
        <h2 class="text-4xl font-semibold text-neutral-900">Consultation Payment</h2>
