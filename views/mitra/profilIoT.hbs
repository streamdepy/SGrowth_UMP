<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Air Quality Monitoring - SGrowth</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes pulse-border {
            0%, 100% {
                border-color: rgb(253, 186, 116);
            }
            50% {
                border-color: rgb(249, 115, 22);
            }
        }
        
        .animate-fade-in-up {
            animation: fadeInUp 0.6s ease-out forwards;
        }
        
        .animate-pulse-border {
            animation: pulse-border 2s ease-in-out infinite;
        }
        
        .card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .card-hover:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(to bottom right, #f0fdfa, #ffffff, #ffedd5);
            min-height: 100vh;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        .profile-header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid white;
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .profile-content {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .profile-content {
                flex-direction: row;
                align-items: center;
            }
        }

        .profile-image-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .profile-image-border {
            width: 8rem;
            height: 8rem;
            border-radius: 50%;
            background: linear-gradient(to bottom right, rgb(251, 146, 60), rgb(234, 88, 12));
            padding: 4px;
            animation: pulse-border 2s ease-in-out infinite;
        }

        .profile-image-inner {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .profile-image {
            width: 7rem;
            height: 7rem;
            object-fit: cover;
            border-radius: 50%;
        }

        .status-badge {
            position: absolute;
            bottom: -0.5rem;
            right: -0.5rem;
            width: 2.5rem;
            height: 2.5rem;
            background: rgb(34, 197, 94);
            border-radius: 50%;
            border: 4px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-info {
            flex: 1;
            text-align: center;
        }

        @media (min-width: 768px) {
            .profile-info {
                text-align: left;
            }
        }

        .welcome-text {
            font-size: 0.875rem;
            font-weight: 600;
            color: rgb(249, 115, 22);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .company-name {
            font-size: 1.875rem;
            font-weight: bold;
            color: rgb(31, 41, 55);
            margin-bottom: 0.5rem;
        }

        .company-details {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
            color: rgb(15, 118, 110);
            justify-content: center;
        }

        @media (min-width: 768px) {
            .company-details {
                justify-content: flex-start;
            }
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
        }

        .status-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgb(254, 242, 242);
            border: 2px solid rgb(254, 202, 202);
            color: rgb(220, 38, 38);
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
            margin-top: 1rem;
        }

        .section-title {
            font-size: 1.875rem;
            font-weight: bold;
            color: rgb(15, 118, 110);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .title-bar {
            width: 0.375rem;
            height: 2rem;
            background: rgb(249, 115, 22);
            border-radius: 9999px;
        }

        .info-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            padding: 2rem;
            border: 1px solid white;
            animation: fadeInUp 0.6s ease-out forwards;
            animation-delay: 0.1s;
        }

        .info-grid {
            display: grid;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .info-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .info-column {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .info-row {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 0.75rem;
            border-radius: 0.5rem;
            transition: background-color 0.3s;
        }

        .info-row:hover {
            background: rgb(240, 253, 250);
        }

        .info-label {
            color: rgb(75, 85, 99);
            font-weight: 500;
            min-width: 140px;
        }

        .info-value {
            color: rgb(15, 118, 110);
            font-weight: 600;
        }

        .chart-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            padding: 2rem;
            border: 1px solid white;
            animation: fadeInUp 0.6s ease-out forwards;
            animation-delay: 0.2s;
            margin-top: 2rem;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .chart-title {
            font-size: 1.5rem;
            font-weight: bold;
            color: rgb(31, 41, 55);
        }

        .chart-subtitle {
            color: rgb(107, 114, 128);
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        .time-selector {
            display: flex;
            gap: 0.5rem;
            background: rgb(243, 244, 246);
            padding: 0.25rem;
            border-radius: 0.5rem;
        }

        .time-btn {
            padding: 0.5rem 1rem;
            border: none;
            background: transparent;
            color: rgb(75, 85, 99);
            font-weight: 500;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .time-btn:hover {
            background: rgb(229, 231, 235);
        }

        .time-btn.active {
            background: white;
            color: rgb(249, 115, 22);
            box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
        }

        .chart-container {
            position: relative;
            height: 400px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: linear-gradient(135deg, rgb(240, 253, 250), rgb(255, 255, 255));
            padding: 1.5rem;
            border-radius: 1rem;
            border: 1px solid rgb(204, 251, 241);
            transition: all 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .stat-label {
            color: rgb(107, 114, 128);
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .stat-value {
            color: rgb(15, 118, 110);
            font-size: 1.875rem;
            font-weight: bold;
        }

        .stat-unit {
            color: rgb(107, 114, 128);
            font-size: 1rem;
            margin-left: 0.25rem;
        }

        .quality-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 0.5rem;
        }

        .quality-good {
            background: rgb(220, 252, 231);
            color: rgb(22, 163, 74);
        }

        .quality-moderate {
            background: rgb(254, 249, 195);
            color: rgb(202, 138, 4);
        }

        .quality-poor {
            background: rgb(254, 226, 226);
            color: rgb(220, 38, 38);
        }
    </style>
</head>
<body>
    <div class="container">
        
        <!-- Profile Header -->
        <div class="profile-header">
            <div class="profile-content">
                <div class="profile-image-wrapper">
                    <div class="profile-image-border">
                        <div class="profile-image-inner">
                            <img src="https://api.builder.io/api/v1/image/assets/TEMP/880531a01c86810a2330e5d2ff1ff5f0134415e1" 
                                 class="profile-image" 
                                 alt="Company Logo" />
                        </div>
                    </div>
                    <div class="status-badge">
                        <svg style="width: 1.25rem; height: 1.25rem; color: white;" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                </div>
                
                <div class="profile-info">
                    <div class="welcome-text">Environment Monitoring</div>
                    <h1 class="company-name">Pengguna - Perusahaan Anda</h1>
                    <div class="company-details">
                        <div class="detail-item">
                            <svg style="width: 1.25rem; height: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                            </svg>
                            <span>Industri Umum</span>
                        </div>
                        <div class="detail-item">
                            <div style="width: 0.375rem; height: 0.375rem; border-radius: 50%; background: rgb(20, 184, 166);"></div>
                            <span>Est. 2020</span>
                        </div>
                        <div class="detail-item">
                            <svg style="width: 1.25rem; height: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Padang, West Sumatra</span>
                        </div>
                    </div>
                    <div>
                        <span class="status-tag">
                            <svg style="width: 1rem; height: 1rem;" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                            Air Quality Monitoring Active
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Company Information -->
        <h2 class="section-title">
            <div class="title-bar"></div>
            Company Profile
        </h2>
        <div class="info-card">
            <div class="info-grid">
                <div class="info-column">
                    <div class="info-row">
                        <span class="info-label">Business Name</span>
                        <span class="info-value">: PT Industri Berkelanjutan</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Business ID</span>
                        <span class="info-value">: CF-IDP0000353</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Headquarters</span>
                        <span class="info-value">: Padang, West Sumatra</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Year Established</span>
                        <span class="info-value">: 2020</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Business Scale</span>
                        <span class="info-value">: International</span>
                    </div>
                </div>
                <div class="info-column">
                    <div class="info-row">
                        <span class="info-label">Target Market</span>
                        <span class="info-value">: Manufacturing & Industry</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Legal Form</span>
                        <span class="info-value">: PT (Perseroan Terbatas)</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Monitoring System</span>
                        <span class="info-value">: Air Quality Sensor v2.0</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Last Updated</span>
                        <span class="info-value">: November 27, 2024</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Compliance Status</span>
                        <span class="info-value">: Active Monitoring</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Air Quality Monitoring Chart -->
        <div class="chart-card">
            <div class="chart-header">
                <div>
                    <h3 class="chart-title">Air Quality Monitoring</h3>
                    <p class="chart-subtitle">Particulate Matter (PM2.5) Levels in Company Area</p>
                </div>
                <div class="time-selector">
                    <button class="time-btn" onclick="updateChart('day')">24H</button>
                    <button class="time-btn active" onclick="updateChart('week')">7D</button>
                    <button class="time-btn" onclick="updateChart('month')">30D</button>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Current PM2.5</div>
                    <div>
                        <span class="stat-value">38</span>
                        <span class="stat-unit">μg/m³</span>
                    </div>
                    <span class="quality-indicator quality-good">Good</span>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Average (7 Days)</div>
                    <div>
                        <span class="stat-value">42</span>
                        <span class="stat-unit">μg/m³</span>
                    </div>
                    <span class="quality-indicator quality-moderate">Moderate</span>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Peak Level</div>
                    <div>
                        <span class="stat-value">68</span>
                        <span class="stat-unit">μg/m³</span>
                    </div>
                    <span class="quality-indicator quality-moderate">Moderate</span>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Safe Days</div>
                    <div>
                        <span class="stat-value">5/7</span>
                        <span class="stat-unit">days</span>
                    </div>
                    <span class="quality-indicator quality-good">71% Compliant</span>
                </div>
            </div>

            <!-- Chart -->
            <div class="chart-container">
                <canvas id="airQualityChart"></canvas>
            </div>
        </div>

    </div>

    <script>
        // Data for different time periods
        const chartData = {
            day: {
                labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00', '23:59'],
                data: [32, 28, 45, 52, 48, 38, 35]
            },
            week: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                data: [35, 42, 48, 38, 45, 52, 38]
            },
            month: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                data: [40, 45, 42, 38]
            }
        };

        let currentChart = null;

        function createChart(period) {
            const ctx = document.getElementById('airQualityChart').getContext('2d');
            
            if (currentChart) {
                currentChart.destroy();
            }

            const data = chartData[period];
            
            currentChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: 'PM2.5 Level (μg/m³)',
                        data: data.data,
                        borderColor: 'rgb(249, 115, 22)',
                        backgroundColor: 'rgba(249, 115, 22, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        pointBackgroundColor: 'rgb(249, 115, 22)',
                        pointBorderColor: 'white',
                        pointBorderWidth: 2,
                        pointHoverBackgroundColor: 'rgb(234, 88, 12)',
                        pointHoverBorderColor: 'white'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                font: {
                                    size: 14,
                                    weight: 'bold'
                                },
                                color: 'rgb(31, 41, 55)',
                                usePointStyle: true,
                                padding: 20
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(31, 41, 55, 0.95)',
                            titleFont: {
                                size: 14,
                                weight: 'bold'
                            },
                            bodyFont: {
                                size: 13
                            },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: true,
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    label += context.parsed.y + ' μg/m³';
                                    
                                    // Add quality indicator
                                    const value = context.parsed.y;
                                    let quality = '';
                                    if (value <= 50) quality = ' (Good)';
                                    else if (value <= 100) quality = ' (Moderate)';
                                    else quality = ' (Poor)';
                                    
                                    return label + quality;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                callback: function(value) {
                                    return value + ' μg/m³';
                                },
                                font: {
                                    size: 12
                                },
                                color: 'rgb(107, 114, 128)'
                            },
                            grid: {
                                color: 'rgba(156, 163, 175, 0.2)',
                                drawBorder: false
                            }
                        },
                        x: {
                            ticks: {
                                font: {
                                    size: 12
                                },
                                color: 'rgb(107, 114, 128)'
                            },
                            grid: {
                                display: false
                            }
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    }
                }
            });
        }

        function updateChart(period) {
            // Update active button
            document.querySelectorAll('.time-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Update chart
            createChart(period);
        }

        // Initialize chart with weekly data
        createChart('week');
    </script>
</body>
</html>