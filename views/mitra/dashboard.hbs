<!DOCTYPE html>
<html lang="id">
<head>
    <title>SGrowth Dashboard</title>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes pulse-border {
            0%, 100% {
                border-color: rgb(253, 186, 116);
            }
            50% {
                border-color: rgb(249, 115, 22);
            }
        }
        
        .animate-fade-in-up {
            animation: fadeInUp 0.6s ease-out forwards;
        }
        
        .animate-pulse-border {
            animation: pulse-border 2s ease-in-out infinite;
        }
        
        .card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .card-hover:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(to bottom right, #f0fdfa, #ffffff, #ffedd5);
            min-height: 100vh;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        .profile-header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid white;
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .profile-content {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .profile-content {
                flex-direction: row;
                align-items: center;
            }
        }

        .profile-image-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .profile-image-border {
            width: 8rem;
            height: 8rem;
            border-radius: 50%;
            background: linear-gradient(to bottom right, rgb(251, 146, 60), rgb(234, 88, 12));
            padding: 4px;
            animation: pulse-border 2s ease-in-out infinite;
        }

        .profile-image-inner {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .profile-image {
            width: 7rem;
            height: 7rem;
            object-fit: cover;
            border-radius: 50%;
        }

        .status-badge {
            position: absolute;
            bottom: -0.5rem;
            right: -0.5rem;
            width: 2.5rem;
            height: 2.5rem;
            background: rgb(34, 197, 94);
            border-radius: 50%;
            border: 4px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-info {
            flex: 1;
            text-align: center;
        }

        @media (min-width: 768px) {
            .profile-info {
                text-align: left;
            }
        }

        .welcome-text {
            font-size: 0.875rem;
            font-weight: 600;
            color: rgb(249, 115, 22);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .company-name {
            font-size: 1.875rem;
            font-weight: bold;
            color: rgb(31, 41, 55);
            margin-bottom: 0.5rem;
        }

        .company-details {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
            color: rgb(15, 118, 110);
            justify-content: center;
        }

        @media (min-width: 768px) {
            .company-details {
                justify-content: flex-start;
            }
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
        }

        .status-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgb(254, 242, 242);
            border: 2px solid rgb(254, 202, 202);
            color: rgb(220, 38, 38);
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
            margin-top: 1rem;
        }

        .section-title {
            font-size: 1.875rem;
            font-weight: bold;
            color: rgb(15, 118, 110);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .title-bar {
            width: 0.375rem;
            height: 2rem;
            background: rgb(249, 115, 22);
            border-radius: 9999px;
        }

        .info-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            padding: 2rem;
            border: 1px solid white;
            animation: fadeInUp 0.6s ease-out forwards;
            animation-delay: 0.1s;
        }

        .info-grid {
            display: grid;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .info-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .info-column {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .info-row {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 0.75rem;
            border-radius: 0.5rem;
            transition: background-color 0.3s;
        }

        .info-row:hover {
            background: rgb(240, 253, 250);
        }

        .info-label {
            color: rgb(75, 85, 99);
            font-weight: 500;
            min-width: 140px;
        }

        .info-value {
            color: rgb(15, 118, 110);
            font-weight: 600;
        }

        .chart-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            padding: 2rem;
            border: 1px solid white;
            animation: fadeInUp 0.6s ease-out forwards;
            animation-delay: 0.2s;
            margin-top: 2rem;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .chart-title {
            font-size: 1.5rem;
            font-weight: bold;
            color: rgb(31, 41, 55);
        }

        .chart-subtitle {
            color: rgb(107, 114, 128);
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        .time-selector {
            display: flex;
            gap: 0.5rem;
            background: rgb(243, 244, 246);
            padding: 0.25rem;
            border-radius: 0.5rem;
        }

        .time-btn {
            padding: 0.5rem 1rem;
            border: none;
            background: transparent;
            color: rgb(75, 85, 99);
            font-weight: 500;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .time-btn:hover {
            background: rgb(229, 231, 235);
        }

        .time-btn.active {
            background: white;
            color: rgb(249, 115, 22);
            box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
        }

        .chart-container {
            position: relative;
            height: 400px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: linear-gradient(135deg, rgb(240, 253, 250), rgb(255, 255, 255));
            padding: 1.5rem;
            border-radius: 1rem;
            border: 1px solid rgb(204, 251, 241);
            transition: all 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .stat-label {
            color: rgb(107, 114, 128);
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .stat-value {
            color: rgb(15, 118, 110);
            font-size: 1.875rem;
            font-weight: bold;
        }

        .stat-unit {
            color: rgb(107, 114, 128);
            font-size: 1rem;
            margin-left: 0.25rem;
        }

        .quality-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 0.5rem;
        }

        .quality-good {
            background: rgb(220, 252, 231);
            color: rgb(22, 163, 74);
        }

        .quality-moderate {
            background: rgb(254, 249, 195);
            color: rgb(202, 138, 4);
        }

        .quality-poor {
            background: rgb(254, 226, 226);
            color: rgb(220, 38, 38);
        }
    </style>
</head>
