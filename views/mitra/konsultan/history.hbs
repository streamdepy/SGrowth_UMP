    <script>

        // Update counts
        function updateCounts() {
            const ongoingCount = document.querySelectorAll('.ongoing-card').length;
            const completedCount = document.querySelectorAll('.completed-card').length;
            
            document.getElementById('ongoingCount').textContent = ongoingCount;
            document.getElementById('completedCount').textContent = completedCount;
            document.getElementById('ongoingBadge').textContent = ongoingCount;
            document.getElementById('completedBadge').textContent = completedCount;
        }

        // Actions
        function viewDetails() {
            alert('Opening consultation details...');
            // In real app: show modal or redirect
        }

        function rateConsultation() {
            alert('Opening rating form...');
            // In real app: show rating modal
        }

        // Hover effects
        document.querySelectorAll('article').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-4px)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Initialize
        updateCounts();
    </script>
